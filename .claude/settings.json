{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/session-bootstrap.mjs\"",
            "async": true,
            "timeout": 360
          }
        ]
      }
    ]
  },
  "maxEffortLevel": "medium",
  "advisorModel": "claude-fable-5-1",
  "idleCompaction": false,
  "memory": {
    "enabled": true,
    "path": ".claude/memory"
  }
}
