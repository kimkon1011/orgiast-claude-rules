{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/session-bootstrap.mjs\"",
            "async": true,
            "timeout": 360
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/booth-event-report-check.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
