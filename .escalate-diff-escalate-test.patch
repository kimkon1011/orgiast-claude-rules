+test('message includes ask and nextClaude with capped lengths', () => {
+  const text = escalationText(row(60, { ask: '問'.repeat(201), nextClaude: '次'.repeat(151) }), now);
+  assert.ok(text.includes(`（ask: ${'問'.repeat(200)}）`));
