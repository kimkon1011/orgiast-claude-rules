  "content_html": "<div id=\"contentsArea\">\n\n<section id=\"outline\" class=\"narrow\">\n<p class=\"txtC\">We introduce clients who have used Orgiast’s services. (Honorifics omitted, in no particular order)</p>\n</section>\n\n<section id=\"clients\" class=\"narrow\">\n<h4 class=\"mb20\"><p>Clients</p></h4>\n<ul class=\"tilesClients\">\n  \n<li>\n<img src=\"https://www.orgiast.jp/wp/wp-content/uploads/2026/06/マークスライフ株式会社ロゴ-1.png\" width=\"90\" height=\"90\" />\n<a href=\"https://marks-house.jp/\" target=\"_blank\"><h5>MarksLife Co., Ltd.</h5></a>\n</li>\n  \n<li>\n<img src=\"https://www.orgiast.jp/wp/wp-content/uploads/2026/04/W2株式会社.png\" width=\"90\" height=\"90\" />\n<a href=\"https://www.w2solution.co.jp/\" target=\"_blank\"><h5>W2 Co., Ltd.</h5></a>\n</li>\n  \n<li>\n<img src=\"https://www.orgiast.jp/wp/wp-content/uploads/2025/12/国立研究開発法人海上・港湾・航空技術研究所.png\" width=\"90\" height=\"90\" />\n<a href=\"https://www.mpat.go.jp/\" target=\"_blank\"><h5>National Institute of Maritime, Port and Aviation Technology</h5></a>\n</li>\n  \n<li>\n<img src=\"https://www.orgiast.jp/wp/wp-content/uploads/2025/11/PDRファーマ株式会社.png\" width=\"90\" height=\"90\" />\n<a href=\"https://www.pdradiopharma.com/\" target=\"_blank\"><h5>PDR Pharma Co., Ltd.</h5></a>\n</li>\n  \n<li>\n<img src=\"https://www.orgiast.jp/wp/wp-content/uploads/2025/11/株式会社taiziii（タイジー）.png\" width=\"90\" height=\"90\" />\n<a href=\"https://taiziii.com/\" target=\"_blank\"><h5>taiziii Co., Ltd.</h5></a>\n</li>\n  \n<li>\n<img src=\"https://www.orgiast.jp/wp/wp-content/uploads/2025/09/オージャストHPロゴ.png\" width=\"90\" height=\"90\" />\n<a href=\"https://www.ricos.co.jp/\" target=\"_blank\"><h5>RICOS Co., Ltd.</h5></a>\n</li>\n  \n<li>\n<img src=\"https://www.orgiast.jp/wp/wp-content/uploads/2025/03/株式会社HRアソシエ.png\" width=\"90\" height=\"90\" />\n<a href=\"https://www.hr-a.jp/\" target=\"_blank\"><h5>HR Associate Co., Ltd.</h5></a>\n</li>\n  \n<li>\n<img src=\"https://www.orgiast.jp/wp/wp-content/uploads/2025/03/株式会社-工房