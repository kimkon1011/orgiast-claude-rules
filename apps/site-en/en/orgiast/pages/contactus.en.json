\t<img alt=\"orgiast-staff05\" src data-image=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2024/02/4.png?fit=200%2C200&amp;ssl=1\" data-thumb=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2024/02/4.png?fit=200%2C200&amp;ssl=1\" title style=\"display:none\"><noscript><img alt=\"orgiast-staff05\"\n\t\t\t\t\t\t     src=\"\" data-image=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2024/02/4.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     data-thumb=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2024/02/4.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     title=\"\"\n\t\t\t\t\t\t     style=\"display:none\"></noscript>\n\n\t\t\t\t\t\t<img alt=\"orgiast-staff06\" src data-image=\"https://i0.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff06.png?fit=200%2C200&amp;ssl=1\" data-thumb=\"https://i0.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff06.png?fit=200%2C200&amp;ssl=1\" title style=\"display:none\"><noscript><img alt=\"orgiast-staff06\"\n\t\t\t\t\t\t     src=\"\" data-image=\"https://i0.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff06.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     data-thumb=\"https://i0.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff06.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     title=\"\"\n\t\t\t\t\t\t     style=\"display:none\"></noscript>\n\n\t\t\t\t\t\t<img alt=\"orgiast-staff07\" src data-image=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff07.png?fit=200%2C200&amp;ssl=1\" data-thumb=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff07.png?fit=200%2C200&amp;ssl=1\" title style=\"display:none\"><noscript><img alt=\"orgiast-staff07\"\n\t\t\t\t\t\t     src=\"\" data-image=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff07.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     data-thumb=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff07.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     title=\"\"\n\t\t\t\t\t\t     style=\"display:none\"></noscript>\n\n\t\t\t\t\t\t<img alt=\"orgiast-staff08\" src data-image=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff08.png?fit=200%2C200&amp;ssl=1\" data-thumb=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff08.png?fit=200%2C200&amp;ssl=1\" title style=\"display:none\"><noscript><img alt=\"orgiast-staff08\"\n\t\t\t\t\t\t     src=\"\" data-image=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff08.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     data-thumb=\"https://i2.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff08.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     title=\"\"\n\t\t\t\t\t\t     style=\"display:none\"></noscript>\n\n\t\t\t\t\t\t<img alt=\"orgiast-staff09\" src data-image=\"https://i0.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff09.png?fit=200%2C200&amp;ssl=1\" data-thumb=\"https://i0.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff09.png?fit=200%2C200&amp;ssl=1\" title style=\"display:none\"><noscript><img alt=\"orgiast-staff09\"\n\t\t\t\t\t\t     src=\"\" data-image=\"https://i0.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff09.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     data-thumb=\"https://i0.wp.com/www.orgiast.jp/wp/wp-content/uploads/2025/04/orgiast-staff09.png?fit=200%2C200&ssl=1\"\n\t\t\t\t\t\t     title=\"\"\n\t\t\t\t\t\t     style=\"display:none\"></noscript>\n\t\t\t</div>\n\n\t\t\t<script type='text/javascript'>\n\t\t\t\twindow.onload = function(e) {\n\t\t\t\t\tif(typeof ugCheckForErrors == \"undefined\"){\n\t\t\t\t\t\tdocument.getElementById(\"unitegallery_1_1\").innerHTML = \"<span style='color:red'>Unite Gallery Error - gallery js and css files not included in the footer. Please make sure that wp_footer() function is added to your theme.</span>\";}\n\t\t\t\t\telse{ ugCheckForErrors(\"unitegallery_1_1\", \"jquery\");}\n\t\t\t\t};\n\t\t\t</script>\n\n\t\t\t<!-- END UNITEGALLERY -->\r\n<Br>\r\n</div>\r\n</section>\r\n\r\n\r\n  <div id=\"contactForm\" class=\"contactForm\">\r\n    <div class=\"contactForm__title\">\r\n      <h2>Inquiry Form</h2>\r\n    </div> <!-- .contactForm__title -->\r\n\r\n    <div class=\"contactForm__inner\">\r\n\r\n      <!-- * contactForm form -->\r\n      <div class=\"contactForm__form\" id=\"js-success-action\">\r\n\r\n        <form id=\"js-form\" class=\"contactForm-form\"\r\n          action=\"https://docs.google.com/forms/u/0/d/e/1FAIpQLSfMRXsDEo_lNS2pGWyDwZdCnZ2yqL-9B7IjcQIpxRtpNEoykw/formResponse\">\r\n\r\n          <!-- 定義リスト -->\r\n          <dl class=\"contactForm-form__dl\">\r\n            <!-- email メールアドレス入力 -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label for=\"your-email\" class=\"\">Email Address</label>\r\n                <span class=\"is-required\"></span>\r\n              </dt> <!-- contactForm-form__label -->\r\n              <dd class=\"contactForm-form__input\">\r\n                <input id=\"your-email\" type=\"email\" placeholder=\"text@example.com\" name=\"emailAddress\">\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n\r\n            <!-- text 名前入力 -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label for=\"your-name\" class=\"\">Name</label>\r\n                <span class=\"is-required\"></span>\r\n              </dt> <!-- contactForm-form__label -->\r\n              <dd class=\"contactForm-form__input\">\r\n                <input id=\"your-name\" type=\"text\" placeholder=\"Taro Yamada\" name=\"entry.2005620554\">\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n\r\n            <!-- text 会社入力 -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label for=\"your-company\" class=\"\">Company Name</label>\r\n              </dt> <!-- contactForm-form__label -->\r\n              <dd class=\"contactForm-form__input\">\r\n                <input id=\"your-company\" type=\"text\" placeholder=\"Company Name\" name=\"entry.481557705\">\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n\r\n            <!-- tel 電話番号入力 -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label for=\"your-tel\" class=\"\">Phone Number</label>\r\n               </dt> <!-- contactForm-form__label -->\r\n              <dd class=\"contactForm-form__input\">\r\n                <input id=\"your-tel\" type=\"tel\" placeholder=\"000-000-000\" name=\"entry.1166974658\">\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n\r\n            <!--  textarea 長文入力 -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label for=\"your-message\" class=\"\">Inquiry Details</label>\r\n                <span class=\"is-required\"></span>\r\n              </dt> <!-- contactForm-form__label -->\r\n              <dd class=\"contactForm-form__input\">\r\n                <textarea name=\"entry.839337160\" id=\"your-message\" placeholder=\"Please enter your inquiry details.\"></textarea>\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n\r\n            <!-- radio ラジオボタン -->\r\n            <!-- ※ nameに値を入れないとradio btnが複数押せるようになる -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label class=\"\" for=\"your-radio\">\r\n                  How did you hear about this site?\r\n                </label>\r\n                <span class=\"is-required\"></span>\r\n              </dt> <!-- contactForm-form__label -->\r\n\r\n              <dd class=\"contactForm-form__input -radio\" id=\"your-radio\">\r\n                <label class=\"contactForm-form__radioWrap\">\r\n                  <input class=\"radio-input\" type=\"radio\" name=\"entry.1137956161\" value=\"検索サイト（Google、Yahoo！など）\">\r\n                  <span class=\"radio-original\"></span>\r\n                  Search engine (Google, Yahoo!, etc.)\r\n                </label>\r\n\r\n                <label class=\"contactForm-form__radioWrap\">\r\n                  <input class=\"radio-input\" type=\"radio\" name=\"entry.1137956161\" value=\"弊社からのメールや電話でのご案内\">\r\n                  <span class=\"radio-original\"></span>\r\n                  Notification from our company via email or phone\r\n                </label>\r\n\r\n                <label class=\"contactForm-form__radioWrap\">\r\n                  <input class=\"radio-input\" type=\"radio\" name=\"entry.1137956161\" value=\"各種SNSなど\">\r\n                  <span class=\"radio-original\"></span>\r\n                  Various social media, etc.\r\n                </label>\r\n\r\n                <label class=\"contactForm-form__radioWrap\">\r\n                  <input class=\"radio-input\" type=\"radio\" name=\"entry.1137956161\" value=\"広告、PR TIMESなど\">\r\n                  <span class=\"radio-original\"></span>\r\n                  Advertisements, PR TIMES, etc.\r\n                </label>\r\n\r\n                <label class=\"contactForm-form__radioWrap\">\r\n                  <input class=\"radio-input\" type=\"radio\" name=\"entry.1137956161\" value=\"知人からの紹介\">\r\n                  <span class=\"radio-original\"></span>\r\n                  Referral from an acquaintance\r\n                </label>\r\n\r\n                <label class=\"contactForm-form__radioWrap -other\">\r\n                  <input class=\"radio-input\" type=\"radio\" name=\"entry.1137956161\" value=\"__other_option__\">\r\n                  <span class=\"radio-original\"></span>\r\n                  Other\r\n                  <input class=\"radio-original-other\" type=\"text\" name=\"entry.1137956161.other_option_response\"\r\n                    placeholder=\"Other\">\r\n                </label>\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n\r\n            <!-- text アンケート入力 -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label for=\"your-key\" class=\"\">\r\n                  If possible, please tell us the &quot;keyword&quot; you searched for or the &quot;referrer.&quot;\r\n                </label>\r\n              </dt> <!-- contactForm-form__label -->\r\n              <dd class=\"contactForm-form__input\">\r\n                <input id=\"your-key\" type=\"text\" placeholder=\"Search word, etc.\" name=\"entry.588557639\">\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n\r\n            <!-- checkbox プライバシーポリシー -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label for=\"your-privacy\" class=\"\">\r\n                  Privacy Policy\r\n                </label>\r\n                <span class=\"is-required\"></span>\r\n              </dt> <!-- contactForm-form__label -->\r\n              <dd class=\"contactForm-form__input -privacy\">\r\n                <input id=\"your-privacy\" type=\"checkbox\" name=\"entry.91289993\" value=\"貴社プライバシーポリシーに同意します\">\r\n                <span>I agree to your company's Privacy Policy.</span>\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n\r\n            <!-- checkbox 送信確認 -->\r\n            <div class=\"contactForm-form__row\">\r\n              <dt class=\"contactForm-form__label\">\r\n                <label for=\"your-submit\" class=\"\">\r\n                  Confirm Submission\r\n                </label>\r\n                <span class=\"is-required\"></span>\r\n              </dt> <!-- contactForm-form__label -->\r\n              <dd class=\"contactForm-form__input -submit\">\r\n                <input id=\"your-submit\" type=\"checkbox\" name=\"entry.1799683657\" value=\"記入完了したので送信して良い\">\r\n                <span>I have completed the entry and am ready to submit.</span>\r\n              </dd> <!-- contactForm-form__input -->\r\n            </div> <!-- contactForm-form__row -->\r\n          </dl> <!-- .contactForm-form__dl -->\r\n\r\n\r\n          <!-- contactForm送信ボタン -->\r\n          <div class=\"contactForm__btn\">\r\n            <input type=\"submit\" id=\"js-submit\" value=\"Submit\" disabled>\r\n          </div> <!-- .contactForm__btn -->\r\n\r\n        </form> <!-- .contactForm-form -->\r\n      </div> <!-- .contactForm__form -->\r\n\r\n    </div> <!-- .contactForm__inner -->\r\n  </div> <!-- .contactForm -->\r\n\r\n\r\n  <!-- CSS 記載 -->\r\n  <style>\r\n    .contactForm {\r\n      width: 95%;\r\n      max-width: 640px;\r\n      margin: 10px auto 40px;\r\n      border: 1px solid rgba(52, 163, 194, 0.662745098);\r\n      border-radius: 10px;\r\n    }\r\n\r\n    @media (min-width: 960px) {\r\n      .contactForm {\r\n        margin: 0 auto;\r\n      }\r\n    }\r\n\r\n    .contactForm__title h2 {\r\n      color: #fff;\r\n      font-size: 28px;\r\n      font-weight: 500;\r\n      text-align: center;\r\n      padding: 15px 0;\r\n      margin: 0;\r\n      background-color: rgba(52, 163, 194, 0.7);\r\n      border-radius: 8px 8px 0 0;\r\n    }\r\n\r\n    @media (min-width: 960px) {\r\n      .contactForm__title h2 {\r\n        font-size: 32px;\r\n        padding: 15px 0;\r\n      }\r\n    }\r\n\r\n    .contactForm-form__dl {\r\n      width: 95%;\r\n      margin: 0 auto;\r\n    }\r\n\r\n    @media (min-width: 960px) {\r\n      .contactForm-form__dl {\r\n        width: 92%;\r\n      }\r\n    }\r\n\r\n    .contactForm-form__row {\r\n      margin: 25px 0;\r\n    }\r\n\r\n    .contactForm-form__label {\r\n      font-size: 15px;\r\n      margin-bottom: 5px;\r\n    }\r\n\r\n    @media (min-width: 960px) {\r\n      .contactForm-form__label {\r\n        font-size: 16px;\r\n      }\r\n    }\r\n\r\n\r\n    .contactForm-form__input {\r\n      font-size: 14px;\r\n      margin: 0;\r\n    }\r\n\r\n    .contactForm-form__input input[type=text],\r\n    .contactForm-form__input input[type=email],\r\n    .contactForm-form__input input[type=tel],\r\n    .contactForm-form__input textarea {\r\n      -webkit-box-sizing: border-box;\r\n      box-sizing: border-box;\r\n      width: 100%;\r\n      padding: 10px 5px;\r\n      background-color: #FBFBFB;\r\n      border: solid 1px #C2C2C2;\r\n    }\r\n\r\n    .contactForm-form__input input[type=text]::-webkit-input-placeholder,\r\n    .contactForm-form__input input[type=email]::-webkit-input-placeholder,\r\n    .contactForm-form__input input[type=tel]::-webkit-input-placeholder,\r\n    .contactForm-form__input textarea::-webkit-input-placeholder {\r\n      color: #C2C2C2;\r\n    }\r\n\r\n    .contactForm-form__input input[type=text]::-moz-placeholder,\r\n    .contactForm-form__input input[type=email]::-moz-placeholder,\r\n    .contactForm-form__input input[type=tel]::-moz-placeholder,\r\n    .contactForm-form__input textarea::-moz-placeholder {\r\n      color: #C2C2C2;\r\n    }\r\n\r\n    .contactForm-form__input input[type=text]:-ms-input-placeholder,\r\n    .contactForm-form__input input[type=email]:-ms-input-placeholder,\r\n    .contactForm-form__input input[type=tel]:-ms-input-placeholder,\r\n    .contactForm-form__input textarea:-ms-input-placeholder {\r\n      color: #C2C2C2;\r\n    }\r\n\r\n    .contactForm-form__input input[type=text]::-ms-input-placeholder,\r\n    .contactForm-form__input input[type=email]::-ms-input-placeholder,\r\n    .contactForm-form__input input[type=tel]::-ms-input-placeholder,\r\n    .contactForm-form__input textarea::-ms-input-placeholder {\r\n      color: #C2C2C2;\r\n    }\r\n\r\n    .contactForm-form__input input[type=text]::placeholder,\r\n    .contactForm-form__input input[type=email]::placeholder,\r\n    .contactForm-form__input input[type=tel]::placeholder,\r\n    .contactForm-form__input textarea::placeholder {\r\n      color: #C2C2C2;\r\n    }\r\n\r\n    .contactForm-form__input input[type=text]:hover,\r\n    .contactForm-form__input input[type=text]:focus,\r\n    .contactForm-form__input input[type=email]:hover,\r\n    .contactForm-form__input input[type=email]:focus,\r\n    .contactForm-form__input input[type=tel]:hover,\r\n    .contactForm-form__input input[type=tel]:focus,\r\n    .contactForm-form__input textarea:hover,\r\n    .contactForm-form__input textarea:focus {\r\n      outline: none;\r\n    }\r\n\r\n    .contactForm-form__input textarea {\r\n      height: 200px;\r\n      resize: vertical;\r\n    }\r\n\r\n    .contactForm-form__input input[type=checkbox] {\r\n      width: 15px;\r\n      height: 15px;\r\n      margin-right: 5px;\r\n      cursor: pointer;\r\n    }\r\n\r\n    .contactForm-form__input.-radio {\r\n      padding: 10px 5px;\r\n      background-color: #FBFBFB;\r\n      border: 1px solid #C2C2C2;\r\n    }\r\n\r\n    .contactForm-form__input.-privacy,\r\n    .contactForm-form__input.-submit {\r\n      display: -webkit-box;\r\n      display: -ms-flexbox;\r\n      display: flex;\r\n      -webkit-box-align: center;\r\n      -ms-flex-align: center;\r\n      align-items: center;\r\n    }\r\n\r\n    @media (min-width: 960px) {\r\n\r\n      .contactForm-form__input.-privacy,\r\n      .contactForm-form__input.-submit {\r\n        padding-left: 10px;\r\n      }\r\n    }\r\n\r\n    .contactForm-form__radioWrap {\r\n      display: -webkit-box;\r\n      display: -ms-flexbox;\r\n      display: flex;\r\n      -webkit-box-align: center;\r\n      -ms-flex-align: center;\r\n      align-items: center;\r\n      margin: 10px 0;\r\n      line-height: 35px;\r\n      cursor: pointer;\r\n      -webkit-user-select: none;\r\n      -moz-user-select: none;\r\n      -ms-user-select: none;\r\n      user-select: none;\r\n    }\r\n\r\n    .contactForm-form__radioWrap input[type=radio] {\r\n      width: 16px;\r\n      height: 16px;\r\n      margin: 5px;\r\n    }\r\n\r\n    .contactForm-form__radioWrap.-other {\r\n      display: block;\r\n    }\r\n\r\n    @media (min-width: 960px) {\r\n      .contactForm-form__radioWrap.-other {\r\n        display: -webkit-box;\r\n        display: -ms-flexbox;\r\n        display: flex;\r\n        -webkit-box-align: center;\r\n        -ms-flex-align: center;\r\n        align-items: center;\r\n      }\r\n    }\r\n\r\n\r\n    .contactForm-form__radioWrap.-other .radio-original-other {\r\n      display: block;\r\n      margin-left: 30px;\r\n      width: 80%;\r\n      background-color: #fff;\r\n    }\r\n\r\n    @media (min-width: 960px) {\r\n      .contactForm-form__radioWrap.-other .radio-original-other {\r\n        margin-left: 20px;\r\n        width: 70%;\r\n      }\r\n    }\r\n\r\n    .contactForm-form__radioWrap input:checked+.radio-original::after {\r\n      opacity: 1;\r\n    }\r\n\r\n    .is-required {\r\n      position: relative;\r\n      padding-right: 20px;\r\n    }\r\n\r\n    .is-required::after {\r\n      position: absolute;\r\n      top: 50%;\r\n      right: 0;\r\n      -webkit-transform: translateY(-70%);\r\n      transform: translateY(-70%);\r\n      content: \"*\";\r\n      display: block;\r\n      width: 15px;\r\n      height: 15px;\r\n      color: red;\r\n      font-size: 24px;\r\n    }\r\n\r\n    .contactForm__btn {\r\n      text-align: center;\r\n      margin-bottom: 25px;\r\n    }\r\n\r\n\r\n    .contactForm__btn input[type=submit] {\r\n      font-size: 16px;\r\n      color: #fff;\r\n      padding: 10px 45px;\r\n      background-color: rgba(52, 163, 194, 0.3);\r\n      border: none;\r\n      border: 1px solid rgba(52, 163, 194, 0.3);\r\n      border-radius: 5px;\r\n      cursor: pointer;\r\n    }\r\n\r\n\r\n    .contactForm__btn input[type=submit].-active {\r\n      background-color: rgba(52, 163, 194, 1);\r\n      transition-duration: 500ms;\r\n    }\r\n\r\n\r\n    .contactForm__message {\r\n      width: 90%;\r\n      margin: 0 auto;\r\n    }\r\n\r\n    .contactForm__message.-error {\r\n      display: none;\r\n      color: red;\r\n    }\r\n  </style>\r\n\r\n\r\n  <!-- JS 記載 -->\r\n  <script>\r\n    // formの入力確認\r\n    const submitButton = document.getElementById('js-submit');\r\n    const form = document.getElementById('js-form');\r\n\r\n    // 全 input と textarea に change イベントを設定\r\n    form.querySelectorAll('input, textarea').forEach(element => {\r\n      element.addEventListener('change', () => {\r\n        // 各入力欄の値を取得\r\n        const email = form.querySelector('input[type=\"email\"]').value.trim();\r\n        const name = form.querySelector('input[name=\"entry.2005620554\"]').value.trim();\r\n        const message = form.querySelector('textarea[name=\"entry.839337160\"]').value.trim();\r\n\r\n        // ラジオボタンの選択状態を取得\r\n        const radioChecked = form.querySelector('input[name=\"entry.1137956161\"]:checked');\r\n        // ラジオボタンの「その他」が選ばれているかチェック\r\n        const isOtherSelected = !!form.querySelector('input[name=\"entry.1137956161\"][value=\"__other_option__\"]:checked');\r\n        // 「その他」の入力欄の値を取得\r\n        const otherTextInput = form.querySelector('input[name=\"entry.1137956161.other_option_response\"]');\r\n        const otherText = otherTextInput ? otherTextInput.value.trim() : \"\";\r\n\r\n\r\n        // チェックボックス（プライバシーポリシー）\r\n        const privacyChecked = form.querySelector('input[name=\"entry.91289993\"]:checked');\r\n        // チェックボックス（送信確認）\r\n        const confirmChecked = form.querySelector('input[name=\"entry.1799683657\"]:checked');\r\n\r\n\r\n        const isValid =\r\n          // 各入力欄が空でないか、\r\n          email !== \"\" &&\r\n          name !== \"\" &&\r\n          message !== \"\" &&\r\n\r\n          // ラジオボタンが1つでもチェックされているか\r\n          radioChecked !== null &&\r\n          // 「その他」が選ばれている場合は、入力欄が空でないこと\r\n          (!isOtherSelected || otherText !== \"\") &&\r\n\r\n          // プライバシーポリシーに同意しているか\r\n          privacyChecked !== null &&\r\n          // 送信確認に同意しているか\r\n          confirmChecked !== null;\r\n\r\n\r\n        // すべての条件が満たされている場合、送信ボタンを有効化\r\n        // それ以外の場合は無効化\r\n        if (isValid) {\r\n          submitButton.disabled = false;\r\n          submitButton.classList.add('-active');\r\n        } else {\r\n          submitButton.disabled = true;\r\n          submitButton.classList.remove('-active');\r\n        }\r\n      });\r\n    });\r\n\r\n\r\n\r\n    // GoogleフォームのURLを指定して、フォームの送信を処理します\r\n    // ページのHTMLがすべて読み込まれた後に、処理を開始します。\r\n    document.addEventListener('DOMContentLoaded', function () {\r\n      // \r\n      const form = document.getElementById('js-form');\r\n\r\n      // フォームが存在すれば、送信イベント（submit）に処理を追加\r\n      if (form) {\r\n        form.addEventListener('submit', function (event) {\r\n          // 通常のフォーム送信（ページ遷移）をキャンセルします。\r\n          event.preventDefault();\r\n\r\n          // フォームの入力値をまとめて取得し、FormDataオブジェクトに格納します。\r\n          const formData = new FormData(form);\r\n          // 非同期通信（AJAX）を行うためのXHRオブジェクトを作成します。\r\n          const xhr = new XMLHttpRequest();\r\n\r\n          xhr.open('POST', 'https://docs.google.com/forms/u/0/d/e/1FAIpQLSfMRXsDEo_lNS2pGWyDwZdCnZ2yqL-9B7IjcQIpxRtpNEoykw/formResponse', true);\r\n\r\n          // Googleフォームのフォーム送信先URLにPOSTリクエストを送るよう設定。\r\n          xhr.onreadystatechange = function () {\r\n            if (xhr.readyState === 4) { // 4はリクエスト完了を意味します\r\n              // Googleフォームではstatusが0でも送信完了してるケースが多い\r\n              if (xhr.status === 200 || xhr.status === 0) {\r\n                // 送信後にthanks.htmlにリダイレクトします\r\n                window.location.href = \"https://www.orgiast.jp/contactform-complete\";\r\n                // 以下の行でフォームの入力をリセットします\r\n                form.reset();\r\n              } else {\r\n                alert(\"送信に失敗しました。もう一度お試しください。\");\r\n              }\r\n            }\r\n          };\r\n\r\n          xhr.send(formData);\r\n        });\r\n      }\r\n    });\r\n  </script>\r\n\r\n\r\n\r\n</div>",
