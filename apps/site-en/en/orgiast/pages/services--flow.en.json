  "content_html": "<div id=\"contentsArea\">\r\n\r\n    <section id=\"outline\" class=\"narrow\">\r\n        <p class=\"txtC\">We provide the application procedure and budget examples for Orgiast’s “Event Production” and “Creative Production” services.<br />If you have any questions or concerns, please feel free to contact us.</p>\r\n    </section>\r\n\r\n    <div class=\"bgLBlue\">\r\n        <div id=\"tabs\">\r\n\r\n            <section class=\"narrow\">\r\n                <nav id=\"tabNav\">\r\n                    <ul>\r\n                        <li class=\"flowEvent\"><a href=\"#tab1\" data-tor-smoothScroll=\"noSmooth\"><span>For Event Production</span></a></li>\r\n                        <li class=\"flowCreative\"><a href=\"#tab2\" data-tor-smoothScroll=\"noSmooth\"><span>For Creative Production</span></a></li>\r\n                    </ul>\r\n                </nav>\r\n            </section>\r\n\r\n            <div id=\"tab1\">\r\n\r\n                <section id=\"flow\" class=\"narrow\">\r\n                    <h4 class=\"mb30\">\r\n                        <p>SERVICE FLOW</p>\r\n                    </h4>\r\n                    <p>\r\n                    <div class=\"flow_img_area\">\r\n                        <div class=\"flow_img_1\"><img src=\"/common/img/page/services/flow/flow_event_1.png\" height=\"auto\" alt data-lazy-src=\"/common/img/page/services/flow/flow_event_1.png?is-pending-load=1\" srcset=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" class=\" jetpack-lazy-image\"><noscript><img src=\"/common/img/page/services/flow/flow_event_1.png\" height=\"auto\" alt=\"\" /></noscript></div>\r\n                        <div class=\"flow_img_2\"><img src=\"/common/img/page/services/flow/flow_event_2.png\" height=\"auto\" alt data-lazy-src=\"/common/img/page/services/flow/flow_event_2.png?is-pending-load=1\" srcset=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" class=\" jetpack-lazy-image\"><