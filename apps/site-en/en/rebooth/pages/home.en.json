  "title": "Home Page",
  "content_html": "<main>\n  <div class=\"p-home__truss\">\n    <svg width=\"840\" height=\"871\" viewBox=\"0 0 840 871\" fill=\"none\" xmlns=\"http://w3.org\">\n      <defs>\n        <!-- 各パスを隠すためのマスク（初期状態は y=\"-871\" で完全に上に隠れた状態） -->\n        <clipPath id=\"clip-path1\">\n          <rect id=\"clip-rect1\" x=\"0\" y=\"-871\" width=\"840\" height=\"871\" />\n        </clipPath>\n\n        <clipPath id=\"clip-path2\">\n          <rect id=\"clip-rect2\" x=\"0\" y=\"-871\" width=\"840\" height=\"871\" />\n        </clipPath>\n\n        <clipPath id=\"clip-path3\">\n          <!-- 横（右）から出現させたい場合は x=\"840\" など初期位置を調整可能。今回は全て上から下にします -->\n          <rect id=\"clip-rect3\" x=\"0\" y=\"-871\" width=\"840\" height=\"871\" />\n        </clipPath>\n      </defs>\n\n      <!-- 元のパスに clip-path を適用 -->\n      <path d=\"M742.58 0H685.76L0 866.31L139.38 870.06L742.58 0Z\" fill=\"var(--primary)\" clip-path=\"url(#clip-path1)\" />\n      <path d=\"M838.69 776.68V411.96L692.03 72.0801L639.69 147.81L838.69 776.68Z\" fill=\"var(--primary)\" clip-path=\"url(#clip-path2)\" />\n      <path d=\"M839.7 272.67V195.8L369.95 536.72H369.88L192.63 793.11L839.7 272.67Z\" fill=\"var(--primary)\" clip-path=\"url(#clip-path3)\" />\n    </svg>\n  </div>\n\n  <div class=\"p-home__booth\">\n    <img src=\"https://rebooth.co.jp/wp-content/themes/rebooth/assets/images/booth.svg\" alt=\"\">\n  </div>\n  <div class=\"wp_block-content\">\n    \n<section class=\"wp-block-group pa-hero alignfull is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group pa-hero-container l-container-fluid is-layout-flow wp-block-group-is-layout-flow\">\n<p class=\"pa-hero__main-copy js-split wp-block-paragraph\">high<br>design<br>Rebooth</p>\n</div>\n</section>\n\n\n\n<section class=\"wp-block-group pa-choose alignfull is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group l-container-fluid is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group pa-choose__header is-layout-flow wp-block-group-is-layout-flow\">\n<p class=\"pa-choose__catch js-split g-fall-text wp-block-paragraph\">reborn recycle rebooth</p>\n</div>\n\n\n\n<div class=\"wp-block-group pa-choose__footer is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group pa-choose__content is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading pa-choose__heading\">Balancing Design Quality and Reusability<br>Reusable Exhibition Booth</h2>\n\n\n\n<p class=\"wp-block-paragraph\">Re:Booth (Re:ブース) retains high design quality,<br>It is a reusable exhibition booth designed for repeated use in future exhibitions.</p>\n\n\n\n<p class=\"wp-block-paragraph\">From “make and discard” to “create and utilize.”</p>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-default has-arrow-next is-decorated has-arrow-next\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://rebooth.co.jp/why-choose-us/\">Reasons for Selection</a></div>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n\n\n<div class=\"wp-block-group alignwide is-layout-constrained wp-block-group-is-layout-constrained\"><div class=\"lazyblock-section-title-8wsJD alignwide wp-block-lazyblock-section-title\"><hgroup class=\"c-title-sec is-dark\">\n\n  <p class=\"c-text--en js-split g-fall-text\">AWARD</p>\n\n  <h2 class=\"c-text--ja\">Awards &amp; Certifications</h2>\n\n</hgroup></div>\n\n\n<p class=\"alignwide wp-block-paragraph\">Re:Booth’s initiatives are highly regarded by public agencies and awards.</p>\n\n\n\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-1a05964e wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:33.34%\">\n<figure class=\"wp-block-image size-full\"><img fetchpriority=\"high\" decoding=\"async\" width=\"1122\" height=\"1402\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Osaka.png\" alt=\"Osaka City Certification\" class=\"wp-image-1454\" srcset=\"https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Osaka.png 1122w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Osaka-360x450.png 360w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Osaka-768x960.png 768w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Osaka-767x959.png 767w\" sizes=\"(max-width: 1122px) 100vw, 1122px\" /></figure>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:33.34%\">\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" width=\"1122\" height=\"1402\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_SDGs.png\" alt=\"Winner of the SDGs Business Hope Award\" class=\"wp-image-1455\" srcset=\"https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_SDGs.png 1122w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_SDGs-360x450.png 360w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_SDGs-768x960.png 768w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_SDGs-767x959.png 767w\" sizes=\"(max-width: 1122px) 100vw, 1122px\" /></figure>\n</div>\n\n\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:33.33%\">\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" width=\"1122\" height=\"1402\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Yemen.png\" alt=\"Recipient of the Osaka Kansai Expo Bronze Award\" class=\"wp-image-1456\" srcset=\"https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Yemen.png 1122w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Yemen-360x450.png 360w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Yemen-768x960.png 768w, https://rebooth.co.jp/wp-content/uploads/2026/09/AWARD_Yemen-767x959.png 767w\" sizes=\"(max-width: 1122px) 100vw, 1122px\" /></figure>\n</div>\n</div>\n</div>\n\n\n<div class=\"lazyblock-post-block-Z1Vh4OQ alignfull wp-block-lazyblock-post-block\">  \n\n  <section class=\"pa-post-block pa-works-block  l-block\">\n    <div class=\"l-container-fluid\">\n      <hgroup class=\"pa-post-block__title c-title-sec\">\n        <p class=\"c-text--en js-split g-fall-text\">works</p>\n        <h2 class=\"c-text--ja\">Results</h2>\n      </hgroup>\n              <p class=\"pa-post-block__lead\">We propose designs that effectively convey your products or services, tailored to industry, exhibition purpose, and venue conditions.<br>We leverage the flexibility of truss structures while also considering configurations that facilitate reuse.</p>\n                    <div class=\"p-archive__list p-works-list\">\n                                   <div class=\"p-archive-list__item g-list-fade-in\">\n               <a class=\"p-works-card\" href=\"https://rebooth.co.jp/works/1538/\">\n                 <div class=\"p-works-card__thumbnail u-media\">\n                                                             <img decoding=\"async\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/10/green-energy-2026-1-1-960x795.jpg\" alt=\"\" loading=\"lazy\">\n                                    </div>\n                 <div class=\"p-works-card__body\">\n                   <h3 class=\"p-works-card__title\">Green Energy &amp; Company Co., Ltd. Exhibition Booth / Sep 2026 / Sustainable Management Week</h3>\n\n                   <div class=\"p-post__cat-list\"><span class=\"p-post__cat\">Environment / Eco</span></div>                 </div>\n               </a>\n             </div>                                   <div class=\"p-archive-list__item g-list-fade-in\">\n               <a class=\"p-works-card\" href=\"https://rebooth.co.jp/works/1275/\">\n                 <div class=\"p-works-card__thumbnail u-media\">\n                                                             <img decoding=\"async\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/08/w2-4-960x521.jpg\" alt=\"\" loading=\"lazy\">\n                                    </div>\n                 <div class=\"p-works-card__body\">\n                   <h3 class=\"p-works-card__title\">W2 Inc. Exhibition Booth / Oct 2026 / EC &amp; Store Week (Japan IT Week)</h3>\n\n                   <div class=\"p-post__cat-list\"><span class=\"p-post__cat\">IT / Information Services</span></div>                 </div>\n               </a>\n             </div>                                   <div class=\"p-archive-list__item g-list-fade-in\">\n               <a class=\"p-works-card\" href=\"https://rebooth.co.jp/works/1267/\">\n                 <div class=\"p-works-card__thumbnail u-media\">\n                                                             <img decoding=\"async\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/08/20260623_094156-960x501.jpg\" alt=\"\" loading=\"lazy\">\n                                    </div>\n                 <div class=\"p-works-card__body\">\n                   <h3 class=\"p-works-card__title\">Marks Life Co., Ltd. (マークスライフ株式会社) Exhibition Booth / June 2026 / Funeral Business Fair 2026</h3>\n\n                   <div class=\"p-post__cat-list\"><span class=\"p-post__cat\">Real Estate / Construction</span></div>                 </div>\n               </a>\n             </div>                                   <div class=\"p-archive-list__item g-list-fade-in\">\n               <a class=\"p-works-card\" href=\"https://rebooth.co.jp/works/1261/\">\n                 <div class=\"p-works-card__thumbnail u-media\">\n                                                             <img decoding=\"async\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/08/IMG_5271-960x720.jpg\" alt=\"\" loading=\"lazy\">\n                                    </div>\n                 <div class=\"p-works-card__body\">\n                   <h3 class=\"p-works-card__title\">Trust Studio Co., Ltd. (トラストスタジオ株式会社) Re:Booth</h3>\n\n                   <div class=\"p-post__cat-list\"><span class=\"p-post__cat\">Event / Entertainment / Video</span></div>                 </div>\n               </a>\n             </div>                                   <div class=\"p-archive-list__item g-list-fade-in\">\n               <a class=\"p-works-card\" href=\"https://rebooth.co.jp/works/1254/\">\n                 <div class=\"p-works-card__thumbnail u-media\">\n                                                             <img decoding=\"async\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/08/IMG_9271-960x512.jpg\" alt=\"\" loading=\"lazy\">\n                                    </div>\n                 <div class=\"p-works-card__body\">\n                   <h3 class=\"p-works-card__title\">Marks Life Co., Ltd. (マークスライフ株式会社) Booth Production</h3>\n\n                   <div class=\"p-post__cat-list\"><span class=\"p-post__cat\">Real Estate / Construction</span></div>                 </div>\n               </a>\n             </div>                                   <div class=\"p-archive-list__item g-list-fade-in\">\n               <a class=\"p-works-card\" href=\"https://rebooth.co.jp/works/1242/\">\n                 <div class=\"p-works-card__thumbnail u-media\">\n                                                             <img decoding=\"async\" src=\"https://rebooth.co.jp/wp-content/uploads/2026/08/20260408_010704-960x720.webp\" alt=\"\" loading=\"lazy\">\n                                    </div>\n                 <div class=\"p-works-card__body\">\n                   <h3 class=\"p-works-card__title\">W2 Co., Ltd. (W2株式会社) Re:Booth Production</h3>\n\n                   <div class=\"p-post__cat-list\"><span class=\"p-post__cat\">IT / Information Services</span></div>                 </div>\n               </a>\n             </div>                  </div>\n        <div class=\"pa-post-block__link\">\n          <div class=\"wp-block-button has-arrow-next is-decorated\">\n            <a class=\"wp-block-button__link wp-element-button \"\n              href=\"\n   