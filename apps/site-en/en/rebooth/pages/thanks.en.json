  "content_html": "<main class=\"p-page\">\n        <div class=\"l-container-fluid\">\n        <ul class=\"c-breadcrumb\" itemscope itemtype=\"https://schema.org/BreadcrumbList\"><li class=\"c-breadcrumb__item\" itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/ListItem\"><a itemprop=\"item\" href=\"https://rebooth.co.jp\"><span itemprop=\"name\" >HOME</span></a><meta itemprop=\"position\" content=\"1\" /></li><li class=\"c-breadcrumb__item\" itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/ListItem\"><span itemprop=\"name\">Your inquiry has been sent</span><meta itemprop=\"position\" content=\"2\" /></li></ul>      </div>\n      <section class=\"p-page__header\">\n        <div class=\"l-container-fluid\">\n          <div class=\"p-page__title c-title-sec \">\n            <p class=\"c-text--en js-split\">\n              thanks            </p>\n            <h1 class=\"c-text--ja p-page__title--fade\">Your inquiry has been sent</h1>\n          </div>\n        </div>\n                                </section>  <div class=\"wp_block-content\">\n    \n<div class=\"wp-block-group l-box l-box-lg is-layout-constrained wp-block-group-is-layout-constrained\">\n<p class=\"wp-block-paragraph\">Thank you very much for your inquiry.<br>Your submission has been received successfully.</p>\n\n\n\n<p class=\"wp-block-paragraph\">A staff member will review the content and typically respond within 2 to 3 business days.<br>In the unlikely event that you do not receive a reply after several days, please contact us again.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Please note that depending on the nature of your inquiry, it may take some time before we can respond.<br>Also, please check whether the email has been routed to your spam folder.</p>\n</div>\n\n\n\n<div class=\"wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-default has-arrow-prev is-decorated has-arrow-prev\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://rebooth.co.jp/\">Home Page</a></div>\n</div>\n\n\n  </div>\n  </div>\n</main>",
