{
  "name": "next-session",
  "displayName": "Orgiast Next Session",
  "description": "Starts the next Claude session and prepares mobile Remote Control tabs from a URI.",
  "version": "0.3.1",
  "publisher": "orgiast",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kimkon1011/orgiast-claude-rules.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Orgiast Next Session",
      "properties": {
        "orgiast.nextSession.mobileTabs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "VS Code 起動時に用意するスマホ Remote Control 用 Claude Code タブ数。0 は無効。"
        },
        "orgiast.nextSession.mobileTabName": {
          "type": "string",
          "default": "スマホ用セッション",
          "description": "スマホ用 Claude Code タブ名の接頭辞。"
        }
      }
    }
  },
  "main": "./extension.js",
  "files": [
    "extension.js",
    "route.js",
    "shell-path.js",
    "README.md",
    "LICENSE"
  ]
}
