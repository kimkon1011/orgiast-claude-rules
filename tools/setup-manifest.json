{
  "version": 1,
  "items": [
    { "id": "cmd:git", "type": "command", "severity": "required", "spec": { "command": "git", "versionRegex": ".+" }, "description": "git 導入", "repairHint": "winget install Git.Git" },
    { "id": "cmd:node", "type": "command", "severity": "required", "spec": { "command": "node", "versionRegex": "\\d+\\.\\d+\\.\\d+" }, "description": "Node.js 導入", "repairHint": "winget install OpenJS.NodeJS.LTS" },
    { "id": "cmd:claude", "type": "command", "severity": "required", "spec": { "command": "claude", "versionRegex": "\\d+\\.\\d+\\.\\d+" }, "description": "Claude Code 導入", "repairHint": "winget install Anthropic.ClaudeCode" },
    { "id": "cmd:codex", "type": "command", "severity": "required", "spec": { "command": "codex", "versionRegex": ".+" }, "description": "Codex CLI 導入", "repairHint": "npm install -g @openai/codex" },
    { "id": "repo:rules", "type": "file-nonempty", "severity": "required", "spec": { "paths": ["orgiast-claude-rules", "Downloads/orgiast-claude-rules"], "kind": "directory" }, "description": "ルールリポ取得", "repair": ["onboarding-sync.mjs", "--force"] },
    { "id": "rules:claude-md", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/CLAUDE.md", "contains": "orgiast" }, "description": "共通ルール取込(CLAUDE.md)", "repair": ["onboarding-sync.mjs", "--force"] },
    { "id": "hook:onboarding-sync", "type": "file-nonempty", "severity": "required", "spec": { "paths": ["orgiast-claude-rules/tools/onboarding-sync.mjs", "Downloads/orgiast-claude-rules/tools/onboarding-sync.mjs"] }, "description": "hook実体(repo直参照): onboarding-sync.mjs", "repair": ["onboarding-sync.mjs", "--force"] },
    { "id": "hook:delegation-warn", "type": "file-nonempty", "severity": "required", "spec": { "paths": ["orgiast-claude-rules/tools/pretooluse-delegation-warn.mjs", "Downloads/orgiast-claude-rules/tools/pretooluse-delegation-warn.mjs"] }, "description": "hook実体(repo直参照): pretooluse-delegation-warn.mjs", "repair": ["onboarding-sync.mjs", "--force"] },
    { "id": "hook:verify-before-done", "type": "file-nonempty", "severity": "required", "spec": { "paths": ["orgiast-claude-rules/tools/verify-before-done-detector.mjs", "Downloads/orgiast-claude-rules/tools/verify-before-done-detector.mjs"] }, "description": "hook実体(repo直参照): verify-before-done-detector.mjs", "repair": ["onboarding-sync.mjs", "--force"] },
    { "id": "hook:cost-loop", "type": "file-nonempty", "severity": "required", "spec": { "paths": ["orgiast-claude-rules/tools/cost-loop.mjs", "Downloads/orgiast-claude-rules/tools/cost-loop.mjs"] }, "description": "hook実体(repo直参照): cost-loop.mjs", "repair": ["onboarding-sync.mjs", "--force"] },
    { "id": "settings:onboarding-sync", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/settings.json", "contains": "onboarding-sync" }, "description": "SessionStart: 共通ルール自動更新", "repair": ["register-hooks.mjs", "--hooks-only"] },
    { "id": "settings:cost-reporter", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/settings.json", "contains": "claude-cost-reporter" }, "description": "SessionStart: 日次コスト報告", "repair": ["register-hooks.mjs", "--hooks-only"] },
    { "id": "settings:tool-adoption", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/settings.json", "contains": "tool-adoption-check" }, "description": "SessionStart: 委譲/使い過ぎチェック", "repair": ["register-hooks.mjs", "--hooks-only"] },
    { "id": "settings:cost-loop", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/settings.json", "contains": "cost-loop" }, "description": "SessionStart: コスト×作業量ループ", "repair": ["register-hooks.mjs", "--hooks-only"] },
    { "id": "settings:delegation-warn", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/settings.json", "contains": "pretooluse-delegation-warn" }, "description": "PreToolUse: 委譲警告/ハードブロック", "repair": ["register-hooks.mjs", "--hooks-only"] },
    { "id": "settings:verify-before-done", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/settings.json", "contains": "verify-before-done" }, "description": "Stop: テスト忘れ防止", "repair": ["register-hooks.mjs", "--hooks-only"] },
    { "id": "settings:setup-converge", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/settings.json", "contains": "setup.mjs" }, "description": "SessionStart: setup.mjs --converge 参照(あるべき状態へ収束)", "repair": ["register-hooks.mjs", "--hooks-only"] },
    { "id": "json:settings", "type": "json-valid", "severity": "required", "spec": { "path": ".claude/settings.json", "bom": false }, "description": "settings.json 妥当(BOM無/parse可=Claude Code起動可)", "repair": ["register-hooks.mjs", "--hooks-only"] },
    { "id": "json:claude", "type": "json-valid", "severity": "required", "spec": { "path": ".claude.json", "bom": false }, "description": ".claude.json 妥当(BOM無/parse可)", "repair": ["register-hooks.mjs"] },
    { "id": "claude:gemini-cli", "type": "file-contains", "severity": "required", "spec": { "path": ".claude.json", "contains": "gemini-cli" }, "description": "Gemini MCP 登録(.claude.json)", "repair": ["register-hooks.mjs"] },
    { "id": "env:cost-reporter", "type": "file-contains", "severity": "optional", "spec": { "path": ".claude/cost-reporter.env", "contains": "DISCORD_COST_WEBHOOK=https://" }, "description": "コスト報告Webhook（未設定＝Discord通知が出ない）", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:keyserve", "type": "file-contains", "severity": "required", "spec": { "path": ".claude/keyserve.env", "contains": "ORGIAST_KEYSERVE_SECRET=" }, "description": "keyserve 正規秘密（無いと鍵が一切配布されない。配布コマンドに -EnrollToken が付いていたか確認）", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:fleet-sheet", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/fleet-sheet.env", "ifPresent": true }, "description": "フリートシート報告(fleet-sheet.env)" },
    { "id": "env:manus", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/manus.env" }, "description": "キー: manus.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:deepseek", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/deepseek.env" }, "description": "キー: deepseek.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:xai", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/xai.env" }, "description": "キー: xai.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:openrouter", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/openrouter.env" }, "description": "キー: openrouter.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:groq", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/groq.env" }, "description": "キー: groq.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:cerebras", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/cerebras.env" }, "description": "キー: cerebras.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:zai", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/zai.env" }, "description": "キー: zai.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:mistral", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/mistral.env" }, "description": "キー: mistral.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:kimi-api", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/kimi-api.env" }, "description": "キー: kimi-api.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:ollama", "type": "file-nonempty", "severity": "optional", "spec": { "path": ".claude/ollama.env" }, "description": "キー: ollama.env", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "env:gemini", "type": "file-contains", "severity": "optional", "spec": { "path": ".gemini/.env", "regex": "GEMINI_API_KEY=." }, "description": "Geminiキー(~/.gemini/.env)", "repair": ["onboarding-sync.mjs", "--keys-only", "--force"] },
    { "id": "task:nightly", "type": "scheduled-task", "severity": "optional", "spec": { "name": "OrgiastNightlyBatch" }, "description": "夜間バッチ 定時タスク(毎日03:00)", "repairHint": "配布インストーラを再実行" },
    { "id": "auth:codex", "type": "json-valid", "severity": "manual", "spec": { "path": ".codex/auth.json", "requiredPath": "tokens.id_token", "bom": false }, "description": "Codexログイン済(auth.jsonにトークン)", "repairHint": "codex login" }
  ]
}
